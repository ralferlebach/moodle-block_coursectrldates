{{!
    @template block_coursectrldates/block_content

    Block content: mini calendar + date list in timeline style + shift modal.

    Reuses local_coursectrl CSS classes and AMD module so shift buttons work
    identically to timeline.php → Terminübersicht.

    Context variables required for this template:
    * courseid        {int}
    * sesskey         {string}
    * showcalendar    {bool}
    * hascalendar     {bool}
    * months          {array}  from calendar_grid_builder
    * hasdays         {bool}
    * days            {array}  day → slot → entry (same structure as timeline)
    * shifturl        {string} URL to local/coursectrl/shift.php
    * timelineurl     {string} URL to local/coursectrl/timeline.php
    * opentimelinelabel {string}

    Example context (json):
    {"courseid":2,"sesskey":"x","showcalendar":true,"hascalendar":false,
     "months":[],"hasdays":false,"days":[],"shifturl":"#","timelineurl":"#",
     "opentimelinelabel":"Open timeline"}
}}

<div class="local_coursectrl_timeline block-coursectrldates-content"
     data-region="local_coursectrl-timeline"
     data-courseid="{{courseid}}"
     data-shifturl="{{shifturl}}">

  {{! Mini calendar }}
  {{#hascalendar}}
  <div class="card mb-2{{^showcalendar}} d-none{{/showcalendar}}"
       data-region="local_coursectrl-calwrapper">
    <div class="card-body p-1">
      <div class="d-flex flex-nowrap overflow-auto gap-2 pb-1"
           data-region="local_coursectrl-calrow"
           style="-webkit-overflow-scrolling:touch">
        {{#months}}
        <div class="coursectrl-cal-month{{#iscurrentmonth}} month-current{{/iscurrentmonth}}">
          <div class="small fw-semibold py-1">
            {{#hasfirstentry}}<a href="#day-{{firstentrykey}}" class="text-decoration-none"
               data-action="jump-to-day" data-daykey="{{firstentrykey}}">{{monthlabel}}</a>{{/hasfirstentry}}
            {{^hasfirstentry}}{{monthlabel}}{{/hasfirstentry}}
          </div>
          {{#weeks}}
          <div class="coursectrl-cal-week">
            {{#days}}
            <div class="{{cellclass}}"
                 {{#hasentries}}data-action="jump-to-day" data-daykey="{{daykey}}"
                 data-ispast="{{#ispast}}1{{/ispast}}{{^ispast}}0{{/ispast}}"{{/hasentries}}
                 {{#hasholidays}}title="{{#holidaynames}}{{name}} {{/holidaynames}}"{{/hasholidays}}>
              {{#inmonth}}{{day}}{{/inmonth}}{{^inmonth}}&nbsp;{{/inmonth}}
            </div>
            {{/days}}
          </div>
          {{/weeks}}
        </div>
        {{/months}}
      </div>
    </div>
  </div>
  {{/hascalendar}}

  {{! Date list }}
  {{#hasdays}}
  <div data-region="local_coursectrl-days">
    {{#days}}
    <div class="card mb-2{{#ispast}} opacity-75{{/ispast}}" data-daykey="{{daykey}}">
      <div class="card-header py-1 d-flex align-items-center gap-2" id="day-{{daykey}}">
        <span class="{{#ispast}}text-muted{{/ispast}} small fw-semibold">{{dayformatted}}</span>
      </div>
      {{#slots}}
      <div class="card-body py-1 px-2">
        <div class="d-flex align-items-center justify-content-between mb-1">
          <span class="small text-muted">{{timeformatted}}</span>
          <span class="d-flex gap-1">
            <button type="button" class="btn btn-sm btn-outline-secondary p-1 lh-1 ccwf-tl-btn"
                    data-action="shift-slot" data-timestamp="{{timekey}}"
                    title="{{#str}} timeline_action_shift_slot, local_coursectrl {{/str}}">
              <i class="fa fa-calendar-day fa-sm"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary p-1 lh-1 ccwf-tl-btn"
                    data-action="shift-following" data-timestamp="{{timekey}}"
                    title="{{#str}} shift_following, local_coursectrl {{/str}}">
              <i class="fa fa-calendar-days fa-sm"></i>
            </button>
          </span>
        </div>
        <ul class="list-group list-group-flush">
          {{#entries}}
          <li class="list-group-item d-flex align-items-center justify-content-between py-1 px-0">
            <span class="text-truncate me-2">
              {{#pix}}monologo, mod_{{modname}}, {{modname}}{{/pix}}
              <a href="{{activityurl}}" target="_blank" rel="noopener noreferrer">{{name}}</a>
              <span class="badge bg-light border text-muted ms-1">{{field}}</span>
            </span>
            <span class="d-flex gap-1 flex-shrink-0">
              <button type="button" class="btn btn-sm btn-outline-secondary p-1 lh-1 ccwf-tl-btn"
                      data-action="shift-entry" data-cmid="{{cmid}}" data-field="{{rawfield}}"
                      title="{{#str}} shift_single, local_coursectrl {{/str}}">
                <i class="fa fa-calendar-day fa-sm"></i>
              </button>
              {{#deletable}}
              <button type="button" class="btn btn-sm btn-outline-danger p-1 lh-1 ccwf-tl-btn"
                      data-action="delete-entry" data-cmid="{{cmid}}" data-field="{{rawfield}}"
                      data-name="{{name}}"
                      title="{{#str}} timeline_action_delete_entry, local_coursectrl {{/str}}">
                <i class="fa fa-times fa-sm"></i>
              </button>
              {{/deletable}}
            </span>
          </li>
          {{/entries}}
        </ul>
      </div>
      {{/slots}}
    </div>
    {{/days}}
  </div>
  {{/hasdays}}
  {{^hasdays}}
  <p class="text-muted small mt-2">{{#str}} no_dates_found, local_coursectrl {{/str}}</p>
  {{/hasdays}}

  {{! Link to full timeline }}
  <div class="mt-2">
    <a href="{{timelineurl}}" class="btn btn-sm btn-outline-secondary d-block">
      <i class="fa fa-calendar-alt fa-fw"></i> {{opentimelinelabel}}
    </a>
  </div>

  {{! Shift dialog (identical to local_coursectrl/timeline) }}
  <div id="coursectrl-shift-dialog" class="modal fade" tabindex="-1" role="dialog"
       style="display:none" aria-hidden="true"
       data-label-config="{{#str}} timeline_shift_heading, local_coursectrl {{/str}}"
       data-label-preview="{{#str}} preview_title, local_coursectrl {{/str}}"
       data-label-textreview="{{#str}} tab_textreview, local_coursectrl {{/str}}"
       data-label-scantext="{{#str}} shift_scan_text, local_coursectrl {{/str}}"
       data-lbl-close="{{#str}} shift_lbl_close, local_coursectrl {{/str}}"
       data-lbl-conf-safe="{{#str}} shift_lbl_conf_safe, local_coursectrl {{/str}}"
       data-lbl-conf-ambiguous="{{#str}} shift_lbl_conf_ambiguous, local_coursectrl {{/str}}"
       data-lbl-conf-info="{{#str}} shift_lbl_conf_informational, local_coursectrl {{/str}}"
       data-err-noselect="{{#str}} shift_err_noselect, local_coursectrl {{/str}}"
       data-err-nodelta="{{#str}} shift_err_nodelta, local_coursectrl {{/str}}"
       data-err-generic="{{#str}} shift_err_generic, local_coursectrl {{/str}}"
       data-msg-nohits="{{#str}} shift_msg_nohits, local_coursectrl {{/str}}"
       data-msg-loading="{{#str}} shift_msg_loading, local_coursectrl {{/str}}"
       data-msg-shifted="{{#str}} shift_msg_shifted, local_coursectrl {{/str}}"
       data-msg-errors="{{#str}} shift_msg_errors, local_coursectrl {{/str}}"
       data-lbl-mark="{{#str}} shift_lbl_mark, local_coursectrl {{/str}}"
       data-lbl-deselect="{{#str}} shift_lbl_deselect, local_coursectrl {{/str}}"
       data-lbl-yearassumed="{{#str}} shift_lbl_yearassumed, local_coursectrl {{/str}}"
       data-lbl-yearlabel="{{#str}} shift_lbl_yearlabel, local_coursectrl {{/str}}"
       data-lbl-ambiguous-notice="{{#str}} shift_lbl_ambiguous_notice, local_coursectrl {{/str}}"
       data-lbl-errtitle="{{#str}} shift_lbl_errtitle, local_coursectrl {{/str}}">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-header py-2">
          <h6 class="modal-title" data-ccwf-title id="coursectrl-shift-dialog-title">
            {{#str}} timeline_shift_heading, local_coursectrl {{/str}}
          </h6>
          <button type="button" class="close btn-close"
                  data-action="close-dialog" aria-label="Close"></button>
        </div>
        <div data-ccwf-step="1">
          <form method="post" action="{{shifturl}}" id="coursectrl-shift-form">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="courseid" value="{{courseid}}">
            <input type="hidden" name="cmids" id="coursectrl-shift-cmids" value="">
            <input type="hidden" name="action_type" value="shift_dates">
            <input type="hidden" name="mode" id="coursectrl-shift-mode" value="slot">
            <input type="hidden" name="followdeps" id="coursectrl-shift-followdeps" value="0">
            <input type="hidden" name="shift_fields" id="coursectrl-shift-fields" value="">
            <div class="modal-body py-2">
              <p id="coursectrl-shift-target" class="small text-muted mb-2"></p>
              <div class="d-flex gap-3 mb-2" style="width:25rem">
                <div class="input-group input-group-sm" style="white-space:nowrap">
                  <input type="number" name="delta_days" id="coursectrl-shift-delta-days"
                         class="form-control" style="width:4rem" value="0">
                  <div class="input-group-append">
                    <span class="input-group-text">
                      {{#str}} timeline_shift_days, local_coursectrl {{/str}}
                    </span>
                  </div>
                </div>
                <div class="input-group input-group-sm" style="white-space:nowrap">
                  <input type="number" name="delta_hours" id="coursectrl-shift-delta-hours"
                         class="form-control" style="width:3.5rem" value="0">
                  <div class="input-group-append">
                    <span class="input-group-text">
                      {{#str}} timeline_shift_hours, local_coursectrl {{/str}}
                    </span>
                  </div>
                </div>
                <div class="input-group input-group-sm" style="white-space:nowrap">
                  <input type="number" name="delta_minutes" id="coursectrl-shift-delta-minutes"
                         class="form-control" style="width:3.5rem" value="0" min="0" max="59">
                  <div class="input-group-append">
                    <span class="input-group-text">
                      {{#str}} minutes, core {{/str}}
                    </span>
                  </div>
                </div>
              </div>
              <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox"
                       id="coursectrl-shift-followdeps-cb">
                <label class="form-check-label small" for="coursectrl-shift-followdeps-cb">
                  {{#str}} shift_dependants, local_coursectrl {{/str}}
                </label>
              </div>
              <p class="text-danger small mt-2 d-none mb-0" data-ccwf-step1-error></p>
            </div>
            <div class="modal-footer py-2 d-flex justify-content-between">
              <button type="button" class="btn btn-sm btn-secondary"
                      data-action="close-dialog">
                {{#str}} cancel, core {{/str}}
              </button>
              <button type="button" class="btn btn-sm btn-primary"
                      data-ccwf-action="preview">
                {{#str}} preview_title, local_coursectrl {{/str}}
              </button>
            </div>
          </form>
        </div>
        <div data-ccwf-step="2" class="d-none">
          <div class="modal-body py-2" data-ccwf-preview-body></div>
          <div class="modal-footer py-2 d-flex justify-content-between">
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-ccwf-action="back">
              {{#str}} shift_back, local_coursectrl {{/str}}
            </button>
            <button type="button" class="btn btn-sm btn-primary"
                    data-ccwf-action="execute">
              {{#str}} timeline_shift_apply, local_coursectrl {{/str}}
            </button>
          </div>
        </div>
        <div data-ccwf-step="3" class="d-none">
          <div class="modal-body py-2">
            <div data-ccwf-shift-result></div>
            <div data-ccwf-hits-body></div>
          </div>
          <div class="modal-footer py-2 d-flex justify-content-between">
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-action="close-dialog">
              {{#str}} shift_no_textchange, local_coursectrl {{/str}}
            </button>
            <button type="button" class="btn btn-sm btn-primary"
                    data-ccwf-action="apply-text">
              {{#str}} shift_ajax_review_apply, local_coursectrl {{/str}}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  {{! Delete dialog (identical to local_coursectrl/timeline) }}
  <div id="coursectrl-delete-dialog" class="modal fade" tabindex="-1" role="dialog"
       style="display:none" aria-hidden="true">
    <div class="modal-dialog modal-sm" role="document">
      <div class="modal-content">
        <div class="modal-header py-2">
          <h6 class="modal-title">
            {{#str}} timeline_delete_heading, local_coursectrl {{/str}}
          </h6>
          <button type="button" class="close btn-close"
                  data-action="close-dialog" aria-label="Close"></button>
        </div>
        <form method="post" action="{{shifturl}}">
          <input type="hidden" name="sesskey" value="{{sesskey}}">
          <input type="hidden" name="courseid" value="{{courseid}}">
          <input type="hidden" name="cmids" id="coursectrl-delete-cmids" value="">
          <input type="hidden" name="action_type" value="unset_dates">
          <input type="hidden" name="fields" id="coursectrl-delete-fields" value="">
          <div class="modal-body py-2">
            <p id="coursectrl-delete-target" class="small mb-0"></p>
          </div>
          <div class="modal-footer py-2 d-flex justify-content-between">
            <button type="button" class="btn btn-sm btn-secondary"
                    data-action="close-dialog">
              {{#str}} cancel, core {{/str}}
            </button>
            <button type="submit" class="btn btn-sm btn-danger">
              {{#str}} delete, core {{/str}}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

</div>

{{#js}}
require(['local_coursectrl/timeline'], function (T) {
    T.init(document.querySelector('[data-region="local_coursectrl-timeline"]'));
});
{{/js}}
