{{!
    @template block_coursectrldates/block

    Outer wrapper for the course-dates block content.

    When showhelp is true, only the Termin-Assistent splash is shown; the
    main content (calendar, event list) is rendered but hidden via CSS.
    Clicking "Nein" in the splash removes it from DOM and reveals the main
    content client-side without a page reload.

    Context variables required for this template:
    * showhelp       {bool}    Show the Termin-Assistent splash.
    * mainhiddenclass {string} CSS class to hide main content ('block-coursectrldates-hidden' or '').
    * helpdata       {object}  Scoped context for block_coursectrldates/splash.
    * showcalendar   {bool}    Show the calendar partial.
    * months         {array}   Calendar months.
    * hasdays        {bool}    Event-list — see block_coursectrldates/event_list.
    * days           {array}   Event-list — see block_coursectrldates/event_list.
    * (all other event_list context variables also at top level)

    Example context (json):
    {
        "showhelp": false,
        "mainhiddenclass": "",
        "helpdata": null,
        "showcalendar": false,
        "hascalendar": false,
        "months": [],
        "hasdays": false,
        "days": [],
        "istruncated": false,
        "shown": 0,
        "total": 0,
        "timelineurl": "#",
        "opentimelinelabel": "Open timeline",
        "viewalllabel": "View all in timeline",
        "noeventsmessage": "No dates found.",
        "shiftslotlabel": "Shift slot",
        "shiftfollowinglabel": "Shift following",
        "shiftentrylabel": "Shift date"
    }
}}
<div class="block-coursectrldates" data-region="block-coursectrldates">
    {{#showhelp}}
        {{#helpdata}}
            {{> block_coursectrldates/splash }}
        {{/helpdata}}
    {{/showhelp}}
    <div data-region="coursectrldates-main" class="block-coursectrldates-main {{mainhiddenclass}}">
        {{#showcalendar}}
            {{> block_coursectrldates/calendar }}
        {{/showcalendar}}
        {{> block_coursectrldates/event_list }}
    </div>
</div>
{{#js}}
require(['block_coursectrldates/block'], function(B) {
    B.init(document.querySelector('[data-region="block-coursectrldates"]'));
});
{{/js}}
