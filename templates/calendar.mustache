{{!
    @template block_coursectrldates/calendar

    Mini calendar section within the course-dates block.

    Context variables required for this template:
    * weeks       {int}   Number of calendar weeks displayed.
    * hascalendar {bool}  Whether pre-built calendar HTML is available.
    * calendardata {array} Calendar rows from local_coursectrl (stub: empty).

    Example context (json):
    {
        "weeks": 4,
        "hascalendar": false,
        "calendardata": []
    }
}}
<div class="block-coursectrldates-calendar" data-region="coursectrldates-calendar">
    {{#hascalendar}}
        {{#calendardata}}
            {{{ . }}}
        {{/calendardata}}
    {{/hascalendar}}
</div>
