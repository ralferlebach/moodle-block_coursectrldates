{{!
    @template block_coursectrldates/event_item

    A single event row in the course-dates event list.

    Context variables required for this template:
    * dateformatted {string} Localised date and time string.
    * cmname        {string} Activity display name.
    * eventlabel    {string} Localised event type description (e.g. "opens").
    * shifturl      {string} URL to the shift-dates action in local_coursectrl.

    Example context (json):
    {
        "dateformatted": "Mon, 4 Nov 2026, 10:00",
        "cmname": "Assignment 1",
        "eventlabel": "opens",
        "shifturl": "/local/coursectrl/manage.php?courseid=2&cmid=5&action=shift_dates"
    }
}}
<li class="block-coursectrldates-event mb-2">
    <div class="small text-muted">{{dateformatted}}</div>
    <div class="fw-bold">{{cmname}}</div>
    <div class="small">{{eventlabel}}</div>
    <a href="{{shifturl}}" class="btn btn-xs btn-outline-primary mt-1">
        {{#str}} shift_dates, block_coursectrldates {{/str}}
    </a>
</li>
