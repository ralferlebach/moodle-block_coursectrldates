{{!
    @template block_coursectrldates/splash

    Termin-Assistent notification card for block_coursectrldates.

    Shown as the sole block content when a trigger fires and the teacher has
    not yet permanently dismissed it. Calendar and event list are hidden
    while this card is visible.

    Actions are handled via the block_coursectrldates_block_action external
    service called from AMD JavaScript (core/ajax). No form POST or action.php
    URL is required in the template.

    Actions:
    * "Ja"         — external service dismiss_help + navigate to manage.php.
    * "Nein"       — remove card from DOM, reveal block content (no server call).
    * "Abschalten" — external service disable_help + reload; only shown to users
                     with addinstance capability.

    Context variables required for this template:
    * splash_title   {string}  Card heading.
    * question       {string}  First text paragraph.
    * question2      {string}  Second text paragraph (the question).
    * managepageurl  {string}  URL for manage.php?courseid=X.
    * instanceid     {int}
    * courseid       {int}
    * label_yes      {string}
    * label_later    {string}
    * label_no       {string}
    * canmanage      {bool}    Whether the user has addinstance capability.

    Example context (json):
    {
        "splash_title":  "Termin-Assistent",
        "question":      "Sie scheinen neue Inhalte importiert zu haben.",
        "question2":     "Möchten Sie jetzt alle neuen Termine einrichten?",
        "managepageurl": "/local/coursectrl/manage.php?courseid=2",
        "instanceid":    3,
        "courseid":      2,
        "label_yes":     "Ja",
        "label_later":   "Nein",
        "label_no":      "Abschalten",
        "canmanage":     true
    }
}}
<div class="block-coursectrldates-splash card border-0 shadow-sm mb-2"
     data-region="coursectrldates-splash">
    <div class="card-body py-3 px-3">
        <h6 class="card-title fw-bold mb-2">{{splash_title}}</h6>
        <p class="mb-1 small text-body">{{question}}</p>
        <p class="mb-3 small text-body fw-semibold">{{question2}}</p>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{managepageurl}}"
               class="btn btn-primary btn-sm block-coursectrldates-helpbtn"
               data-action="dismiss-help-and-go"
               data-instanceid="{{instanceid}}"
               data-courseid="{{courseid}}">
                {{label_yes}}
            </a>
            <button type="button"
                    class="btn btn-outline-secondary btn-sm block-coursectrldates-helpbtn"
                    data-action="defer-help">
                {{label_later}}
            </button>
            {{#canmanage}}
            <button type="button"
                    class="btn btn-link btn-sm text-muted p-0 text-decoration-none"
                    data-action="disable-help"
                    data-instanceid="{{instanceid}}"
                    data-courseid="{{courseid}}">
                {{label_no}}
            </button>
            {{/canmanage}}
        </div>
    </div>
</div>
