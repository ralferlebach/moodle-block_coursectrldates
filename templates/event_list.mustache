{{!
    @template block_coursectrldates/event_list

    Compact timeline-style date list for the course-dates block.

    Context variables required for this template:
    * hasdays            {bool}
    * days               {array}
    * istruncated        {bool}
    * shown              {int}
    * total              {int}
    * timelineurl        {string}
    * opentimelinelabel  {string}
    * viewalllabel       {string}
    * noeventsmessage    {string}
    * shiftslotlabel     {string}
    * shiftfollowinglabel {string}
    * shiftentrylabel    {string}
    * canshift           {bool}   True when user has local/coursectrl:bulkaction.

    Example context (json):
    {
        "hasdays": true,
        "days": [{
            "daykey": "2026-05-09",
            "dayformatted": "Saturday, 9 May 2026",
            "ispast": false,
            "slots": [{
                "timeformatted": "16:11",
                "timekey": 1746803460,
                "ispast": false,
                "shiftsloturl": "/local/coursectrl/timeline.php?courseid=2",
                "shiftfollowingurl": "/local/coursectrl/timeline.php?courseid=2",
                "entries": [{
                    "cmid": 5,
                    "name": "Glossar",
                    "modname": "glossary",
                    "field": "Erinnerung in der Zeitleiste setzen",
                    "activityurl": "/mod/glossary/view.php?id=5",
                    "shiftentryurl": "/local/coursectrl/timeline.php?courseid=2"
                }]
            }]
        }],
        "istruncated": false,
        "shown": 1,
        "total": 1,
        "timelineurl": "/local/coursectrl/timeline.php?courseid=2",
        "opentimelinelabel": "Open timeline",
        "viewalllabel": "View all in timeline",
        "noeventsmessage": "No course dates found.",
        "shiftslotlabel": "Shift this time slot",
        "shiftfollowinglabel": "Shift following dates",
        "shiftentrylabel": "Shift this date",
        "canshift": true
    }
}}
<div class="block-coursectrldates-eventlist" data-region="coursectrldates-eventlist">

    {{#hasdays}}
    {{#days}}
    <div class="card mb-2{{#ispast}} opacity-75{{/ispast}}" data-daykey="{{daykey}}">
        <div class="card-header py-1 d-flex align-items-center gap-2"
             id="ccd-day-{{daykey}}">
            <span class="{{#ispast}}text-muted{{/ispast}}">{{dayformatted}}</span>
        </div>
        {{#slots}}
        <div class="card-body py-1 px-2">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <span class="small text-muted">{{timeformatted}}</span>
                {{#canshift}}
                <span class="d-flex gap-1">
                    <a href="{{shiftsloturl}}"
                       class="btn btn-sm btn-outline-secondary p-1 lh-1 block-coursectrldates-shiftbtn ccwf-tl-btn"
                       title="{{shiftslotlabel}}"
                       aria-label="{{shiftslotlabel}}">
                        <i class="fa fa-calendar-day fa-sm"></i>
                    </a>
                    <a href="{{shiftfollowingurl}}"
                       class="btn btn-sm btn-outline-secondary p-1 lh-1 block-coursectrldates-shiftbtn ccwf-tl-btn"
                       title="{{shiftfollowinglabel}}"
                       aria-label="{{shiftfollowinglabel}}">
                        <i class="fa fa-calendar-days fa-sm"></i>
                    </a>
                </span>
                {{/canshift}}
            </div>
            <ul class="list-group list-group-flush">
                {{#entries}}
                <li class="list-group-item d-flex align-items-center
                            justify-content-between py-1 px-0">
                    <span class="text-truncate me-2">
                        {{#pix}}monologo, mod_{{modname}}, {{modname}}{{/pix}}
                        <a href="{{activityurl}}" target="_blank"
                           rel="noopener noreferrer">{{name}}</a><br>
                        <span class="badge bg-light border text-muted ms-1">
                            {{field}}
                        </span>
                    </span>
                    <span class="flex-shrink-0">
                        {{#canshift}}
                        <a href="{{shiftentryurl}}"
                           class="btn btn-sm btn-outline-secondary p-1 lh-1 block-coursectrldates-shiftbtn ccwf-tl-btn"
                           title="{{shiftentrylabel}}"
                           aria-label="{{shiftentrylabel}}">
                            <i class="fa fa-calendar-day fa-sm"></i>
                        </a>
                        {{/canshift}}
                    </span>
                </li>
                {{/entries}}
            </ul>
        </div>
        {{/slots}}
    </div>
    {{/days}}

    {{#istruncated}}
    <p class="small text-muted mb-1">{{shown}} / {{total}}</p>
    <a href="{{timelineurl}}"
       class="btn btn-sm btn-outline-secondary d-block mb-2">
        {{viewalllabel}}
    </a>
    {{/istruncated}}
    {{^istruncated}}
    <a href="{{timelineurl}}"
       class="btn btn-sm btn-outline-secondary d-block mt-1 mb-1">
        {{opentimelinelabel}}
    </a>
    {{/istruncated}}
    {{/hasdays}}

    {{^hasdays}}
    <p class="text-muted small mb-2">{{noeventsmessage}}</p>
    <a href="{{timelineurl}}"
       class="btn btn-sm btn-outline-secondary d-block">
        {{opentimelinelabel}}
    </a>
    {{/hasdays}}

</div>
